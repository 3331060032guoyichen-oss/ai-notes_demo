# 复制为 .env.local 并填入你自己的值，.env.local 不会被提交。

# 必填：DeepSeek API Key，用于"AI 整理"功能（POST /api/organize）。
# 没有这个变量时，其余功能（新建笔记、知识库、图谱、Wiki）仍可正常使用，
# 只有点击"AI 整理"会返回错误。
# 在 https://platform.deepseek.com 申请。
DEEPSEEK_API_KEY=

# 可选：以下三项有默认值，一般不需要修改。
# DeepSeek API 的基础地址。
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型名。
# DEEPSEEK_MODEL=deepseek-chat

# 单次请求超时时间（毫秒）。
# DEEPSEEK_TIMEOUT_MS=30000
